<div class="account-menu relative">
    <button
        class="icon-button account-button inline-flex h-9 w-9 items-center justify-center rounded-full border border-(--control-border) bg-(--surface) text-slate-600 transition hover:bg-(--control-hover)"
        type="button" aria-label="account" aria-expanded="false" aria-haspopup="true">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
            <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/>
        </svg>
    </button>
    <div
        class="account-dropdown absolute right-0 top-12 z-20 hidden min-w-40 rounded-(--radius-popup-container) border border-(--menu-border) bg-(--menu-bg) p-1 shadow-lg"
        aria-label="Account actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Auth" asp-action="Logout" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button
                    class="account-action logout w-full rounded-(--radius-button) bg-(--button-danger) px-3 py-2 text-left text-sm font-semibold text-white hover:bg-(--button-danger-hover)"
                    type="submit">Logout
                </button>
            </form>
        }
        else
        {
            <button
                class="account-action login block w-full rounded-(--radius-button) bg-(--button-primary) px-3 py-2 text-left text-sm font-semibold text-white hover:bg-(--button-primary-hover)"
                type="button" data-auth-open="login">Login
            </button>
            <button
                class="account-action signup mt-1 block w-full rounded-(--radius-button) border border-(--control-border) bg-(--surface) px-3 py-2 text-left text-sm font-semibold text-(--button-secondary-text) hover:bg-(--control-hover)"
                type="button" data-auth-open="signup">Register
            </button>
        }
    </div>
</div>

<div class="product-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
     data-product-overlay hidden>
    <section class="product-popup relative w-full max-w-lg border border-(--header-border) bg-(--surface) p-5 shadow-xl"
             role="dialog" aria-modal="true" aria-labelledby="product-detail-title">
        <button
            class="absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center text-white bg-(--button-danger) hover:bg-(--button-danger-hover)"
            type="button" aria-label="Close product details" data-product-close>X
        </button>
        <form class="product-detail-form grid gap-5" data-product-form>
            <img class="product-detail-image w-full bg-(--surface-muted)" data-product-detail-image src="" alt=""/>
            <div class="grid gap-3">
                <div class="flex items-start justify-between gap-4 pr-8">
                    <div>
                        <span
                            class="mb-1 inline-block rounded-full bg-(--sale) px-2.5 py-1 text-xs font-bold text-white"
                            data-product-detail-discount></span>
                        <h2 id="product-detail-title" class="text-xl font-bold text-(--ink)"
                            data-product-detail-name></h2>
                    </div>
                    <div class="shrink-0 text-right">
                        <span class="block text-sm text-(--muted) line-through" data-product-detail-price></span>
                        <strong class="text-xl font-bold text-(--sale)" data-product-detail-sale-price></strong>
                    </div>
                </div>
                <p class="text-sm leading-6 text-(--muted)" data-product-detail-description></p>
                <label class="grid gap-1 text-sm font-semibold text-(--button-secondary-text)">
                    Quantity
                    <input class="h-10 w-24 px-3 outline-none border border-(--control-border) ring-(--accent)"
                           type="number" name="quantity" min="1" value="1" required/>
                </label>
                <div class="flex gap-3 pt-1">
                    <button
                        class="product-add inline-flex min-h-10 flex-1 items-center justify-center border border-(--control-border) px-4 text-sm font-semibold text-(--button-secondary-text) hover:bg-(--control-hover)"
                        type="submit" data-product-detail-add>Add to cart
                    </button>
                    <button
                        class="product-buy inline-flex min-h-10 flex-1 items-center justify-center bg-(--button-primary) px-4 text-sm font-semibold text-white hover:bg-(--button-primary-hover)"
                        type="button" data-product-detail-buy>Buy now
                    </button>
                </div>
            </div>
        </form>
    </section>
</div>

@{
    var products = new[]
    {
        new
        {
            Name = "Aurora Headphones", Price = "$129", SalePrice = "$99", Discount = "23% OFF",
            Image = "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=900&q=85",
            Description = "Wireless over-ear headphones with rich sound and all-day comfort."
        },
        new
        {
            Name = "Atlas Backpack", Price = "$89", SalePrice = "$64", Discount = "28% OFF",
            Image = "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=900&q=85",
            Description = "A durable everyday backpack with a clean profile and room for your essentials."
        },
        new
        {
            Name = "Lumen Desk Lamp", Price = "$72", SalePrice = "$49", Discount = "32% OFF",
            Image = "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=900&q=85",
            Description = "A warm, adjustable desk lamp designed for focused work and calm evenings."
        },
        new
        {
            Name = "Terra Bottle", Price = "$38", SalePrice = "$29", Discount = "24% OFF",
            Image = "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=900&q=85",
            Description = "A lightweight insulated bottle that keeps drinks cold or warm throughout the day."
        }
    };
}

<section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4" aria-label="Product list">
    @foreach (var product in products)
    {
        <article class="product-card group overflow-hidden bg-(--surface) shadow-sm"
                 tabindex="0" role="region" data-product-card
                 data-product-name="@product.Name" data-product-price="@product.Price"
                 data-product-sale-price="@product.SalePrice" data-product-discount="@product.Discount"
                 data-product-image="@product.Image" data-product-description="@product.Description">
            <div class="relative overflow-hidden bg-(--surface-muted)">
                <img class="h-52 w-full object-cover" src="@product.Image" alt="@product.Name" loading="lazy"/>
                <span class="absolute left-3 top-3 rounded-full bg-(--sale) px-2.5 py-1 text-xs font-bold text-white">
                    @product.Discount
                </span>
            </div>
            <div class="space-y-4 p-4">
                <div class="flex items-start justify-between gap-4">
                    <h2 class="font-semibold text-(--ink)">@product.Name</h2>
                    <div class="shrink-0 text-right">
                        <span class="block text-sm text-(--muted)] line-through">@product.Price</span>
                        <strong class="text-lg font-bold text-(--sale)">@product.SalePrice</strong>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button
                        class="product-add inline-flex min-h-10 flex-1 items-center justify-center border border-(--control-border) px-3 text-sm font-semibold text-(--button-secondary-text) hover:bg-(--control-hover)"
                        type="button" data-product-add>Add to cart
                    </button>
                    <button
                        class="product-buy inline-flex min-h-10 flex-1 items-center justify-center bg-(--button-primary) px-3 text-sm font-semibold text-white hover:bg-(--button-primary-hover)"
                        type="button" data-product-buy>Buy now
                    </button>
                </div>
            </div>
        </article>
    }
</section>

@await Html.PartialAsync("_ProductDetailOverlay")
